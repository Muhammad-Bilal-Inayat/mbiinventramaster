  ORGANIZATIONS {
    bigint id PK
  }
  BRANCHES {
    bigint id PK
    bigint organization_id FK
    varchar name
    varchar code
    boolean active
  }
  USERS {
    bigint id PK
    bigint organization_id FK
    varchar name
    varchar email
    varchar password_hash
    boolean mfa_enabled
    boolean active
  }
  USER_BRANCHES {
    bigint user_id FK
    bigint branch_id FK
    boolean is_primary
  }
  ROLES {
    bigint id PK
    varchar name
  }
  PERMISSIONS {
    bigint id PK
    varchar code
    varchar module
    varchar action
  }
  USER_ROLES {
    bigint user_id FK
    bigint role_id FK
  }
  ROLE_PERMISSIONS {
    bigint role_id FK
    bigint permission_id FK
  }
  MEDICINES {
    bigint id PK
    bigint organization_id FK
    varchar sku
    varchar barcode
    varchar name
    varchar strength
    varchar form
    boolean controlled
  }
  MEDICINE_BATCHES {
    bigint id PK
    bigint medicine_id FK
    varchar batch_no
    date expiry_date
    decimal purchase_price
    decimal sale_price
  }
  BRANCH_STOCK {
    bigint id PK
    bigint branch_id FK
    bigint batch_id FK
    int quantity
    int reserved
    int reorder_level
    varchar bin_location
  }
  STOCK_MOVEMENTS {
    bigint id PK
    bigint branch_id FK
    bigint batch_id FK
    varchar type
    int quantity
    varchar reference_id
    bigint created_by FK
  }
  SALES {
    bigint id PK
    bigint branch_id FK
    bigint user_id FK
    varchar invoice_no
    decimal total
    decimal discount
    varchar status
    datetime created_at
  }
  SALE_ITEMS {
    bigint id PK
    bigint sale_id FK
    bigint batch_id FK
    int quantity
    decimal unit_price
    decimal line_total
  }
  PURCHASES {
    bigint id PK
    bigint branch_id FK
    varchar supplier_name
    decimal total
    varchar status
    datetime created_at
  }
  PURCHASE_ITEMS {
    bigint id PK
    bigint purchase_id FK
    bigint batch_id FK
    int quantity
    decimal unit_cost
  }
  STOCK_TRANSFERS {
    bigint id PK
    bigint from_branch_id FK
    bigint to_branch_id FK
    varchar status
    bigint approved_by FK
  }
  TRANSFER_ITEMS {
    bigint id PK
    bigint transfer_id FK
    bigint batch_id FK
    int quantity
  }
  DEVICES {
    bigint id PK
    bigint user_id FK
    bigint branch_id FK
    varchar device_name
    varchar hwid_hash
    varchar public_key
    varchar status
    datetime last_seen
  }
  AUDIT_LOGS {
    bigint id PK
    bigint user_id FK
    varchar action
    varchar entity
    varchar entity_id
    text before_json
    text after_json
    varchar ip_address
    datetime created_at
  }
