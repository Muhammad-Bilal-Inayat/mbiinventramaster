flowchart TB
  subgraph Users[Users & Access]
    A[Owner / Super Admin]
    B[Branch Manager]
    C[Pharmacist]
    D[Cashier]
    E[Auditor]
  end

  subgraph Clients[Client Applications]
    W[Web Admin Portal]
    POS[Branch POS / Barcode Scanner]
    M[Mobile Manager App]
  end

  subgraph Edge[Cloud Edge]
    CDN[CDN + WAF]
    API[API Gateway / Load Balancer]
    AUTH[Auth Service\nJWT + MFA + RBAC]
  end

  subgraph Core[Core Application Services]
    TEN[Tenant & Branch Service]
    INV[Inventory & Batch Service]
    SALE[Sales / POS Service]
    PUR[Purchase & Supplier Service]
    RX[Prescription Service]
    REP[Reports & Analytics Service]
    NOTI[Notification Service]
    AUD[Audit & Compliance Service]
  end

  subgraph Data[Data & Infrastructure]
    DB[(PostgreSQL\nPrimary Database)]
    REDIS[(Redis\nCache + Locks)]
    Q[Message Queue\nRabbitMQ / SQS]
    OBJ[(Object Storage\nInvoices, Rx, Backups)]
    BI[(Read Replica /\nAnalytics Warehouse)]
  end

  subgraph External[External Integrations]
    PAY[Payment Gateway]
    MSG[SMS / WhatsApp / Email]
    TAX[Tax / E-Invoice API]
    BAR[Barcode / Thermal Printer]
  end

  A-->W
  B-->W
  C-->POS
  D-->POS
  E-->W
  W-->CDN
  POS-->CDN
  M-->CDN
  CDN-->API
  API-->AUTH
  API-->TEN
  API-->INV
  API-->SALE
  API-->PUR
  API-->RX
  API-->REP
  API-->NOTI
  API-->AUD
  TEN-->DB
  INV-->DB
  SALE-->DB
  PUR-->DB
  RX-->OBJ
  REP-->BI
  DB-->BI
  INV-->REDIS
  SALE-->REDIS
  SALE-->Q
  INV-->Q
  NOTI-->Q
  AUD-->DB
  SALE-->PAY
  NOTI-->MSG
  SALE-->TAX
  POS-->BAR
  Q-->OBJ

  classDef user fill:#E8F3F1,stroke:#0F766E,color:#083344
  classDef client fill:#E9F2FF,stroke:#2563EB,color:#172554
