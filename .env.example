# Copy to .env for local/VPS use. NEVER commit a real .env file.
# JWT_SECRET is REQUIRED in production: the server will not start without it.
NODE_ENV=production
PORT=3000
JWT_SECRET=change-me-to-a-long-random-secret
STORAGE_MODE=mariadb
LOG_LEVEL=info
CORS_ORIGIN=
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_USER=mbi
MARIADB_PASSWORD=change-me
MARIADB_DATABASE=master_control
MARIADB_ROOT_PASSWORD=change-me-root
REDIS_URL=redis://redis:6379
ALLOW_DEMO_AUTH=false
DATA_DIR=/var/lib/mbi-data
# Phase 1: only set this on the server to enable POST /api/master/tenants.
# Leave it empty/unset and provisioning stays disabled (503).
MASTER_ADMIN_KEY=
# AI (Groq, env only — never in Git, never in chat). Leave empty to disable AI (503).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Tenant database names. Default empty: tenant_000001, tenant_000002, ...
# Shared hosting often allows a database user to create only databases
# starting with the account prefix (e.g. "mbiinv_"). Set the prefix here
# (letters, digits, underscore only) to create "mbiinv_tenant_000001".
# Leave empty unless your host restricts database names to a prefix.
TENANT_DB_PREFIX=
